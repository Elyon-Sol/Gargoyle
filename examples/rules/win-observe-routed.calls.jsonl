{"note": "any other move on the share is observed", "tool": "move_file", "args": {"source": "C:\\gargoyle-share\\it-test\\log.txt", "destination": "C:\\gargoyle-share\\it-test\\log-renamed.txt"}, "expect": {"action": "allow", "rule": 15}}
{"note": "reads are free", "tool": "read_file", "args": {"path": "C:\\gargoyle-share\\hello.txt"}, "expect": {"action": "allow", "rule": 14}}
{"note": "a script written with a trailing dot is the same script once canonical (gate refuses the name before the policy; the policy agrees)", "tool": "write_file", "args": {"path": "C:\\gargoyle-share\\soak\\t1.ps1.", "content": "x"}, "expect": {"action": "hold", "rule": 1}}
